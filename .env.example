# ---------------------------------------------------------------------------
# AiWork Gateway —— 环境变量配置模板
#
# 复制成 .env 再改：cp .env.example .env
# .env 里有真实密钥和管理密码，切勿提交到 git
# ---------------------------------------------------------------------------

# === 管理权限 (ADR-0012，取代 ADR-0002 的管理凭据分离) ===
# 1) 管理口令：可选。留空 = 管理权限随调用凭据授予，打开控制台即可管理。
#    设置后管理面会额外要求一次口令登录，且调用凭据不能顶替；
#    注意还需取消 docker-compose.yml 中 ADMIN_PASSWORD 那一行的注释才会传入容器。
ADMIN_PASSWORD=

# 2) 客户端调用密钥：用于 OpenAI/Responses/Messages 客户端模型调用鉴权
#    格式："sk-xxx:名称,sk-yyy:名称2"，可分配全部账号或绑定指定账号集合
API_KEYS=sk-change-me-please:default

# === 容器实例 ===
# 容器名，默认 aiwork（TLS profile 的 Caddy 容器跟随为 <CONTAINER_NAME>-caddy）
# 同一台机器上跑第二个实例时改成别的名字，否则 compose 会撞名
# CONTAINER_NAME=aiwork

# === 宿主机登录态 ===
# 官方 CLI 登录态目录（只读挂进容器的 /accounts/default）。留空 = ~/.local/share/agentix
# Windows 上通常是 C:/Users/你的用户名/.agentix；quickstart.sh 会按探测结果自动写入
# 用正斜杠，别写反斜杠
AGENTIX_HOST_STATE_DIR=

# === 监听与网络安全 (ADR-0005 & US 53) ===
# 宿主机端口（8080 被占用时改成 18080 之类；容器内始终是 8080）
HOST_PORT=8080

# 默认安全回环监听：127.0.0.1（仅允许宿主机本地或同机反向代理访问）
# 若需要直接对外暴露端口（模式 A），须显式改成 0.0.0.0，并务必配置 ADMIN_PASSWORD 与 API_KEYS
PUBLISH_ADDR=127.0.0.1

# 每个 Key 每分钟最多请求数，0 = 不限
RATE_LIMIT_PER_MIN=60

# 是否提供网页界面（1=开，0=只留 API）
PUBLIC_UI=1

# 允许的跨域来源。给浏览器前端直连时才需要，服务端调用留 *
CORS_ORIGIN=*

# IP 白名单（强烈建议：没有域名、直接对外开端口时配置）
# 逗号分隔，支持 /24 这类 CIDR；留空 = 允许所有来源
# ALLOW_IPS=1.2.3.4,5.6.7.0/24

# 访问日志（一行一条 JSON，docker logs 可看，敏感内容脱敏）
LOG_REQUESTS=1

# 请求日志 JSONL 归档（1=按天写 <DATA_DIR>/logs/requests-YYYY-MM-DD.jsonl，0=只留内存最近记录）
REQUEST_LOG_ARCHIVE=1
# 归档保留天数与容量上限（页面的「网络与日志」组可改，保存即生效）
REQUEST_LOG_RETENTION_DAYS=14
REQUEST_LOG_MAX_MB=200

# 容器前挂了反向代理时设为 1，用于记录真实客户端 IP
TRUST_PROXY=0

# === 域名模式（docker compose --profile tls 时必填）===
# 把域名 A 记录指到本机公网 IP，并确保 80/443 未被占用
DOMAIN=

# 上域名时建议保持：
#   PUBLISH_ADDR=127.0.0.1
#   TRUST_PROXY=1

# === 上游与多账号池配置 (ADR-0003) ===
# direct = 直连 aiwork-api.dtagi.cn（默认正式模式，无 agent 开销）
# agent  = 走本地 CLI 智能体（实验能力，独立部署，具备命令与文件操作权限）
UPSTREAM=direct

# 上游直连地址（自建反代时可修改）
ROUTER_BASE_URL=https://aiwork-api.dtagi.cn

# 额度看板取数地址（可选）。只影响管理台「额度看板」的上游额度查询，
# 不影响模型目录、设备授权与 Router Key 交换。留空 = 官方地址 https://aiwork-api.dtagi.cn
AIWORK_BILLING_BASE_URL=

# 多账号状态目录配置（以逗号分隔，格式 "账号ID:状态目录路径:ro"）
# 示例：UPSTREAM_ACCOUNTS=acc1:/accounts/acc1:ro,acc2:/accounts/acc2:ro
# 留空时默认读取 AGENTIX_STATE_DIR
UPSTREAM_ACCOUNTS=
AGENTIX_STATE_DIR=/accounts/default

# 调度与尝试上限配置 (ADR-0004)
# 针对单请求的最大不同账号尝试次数（包含首次账号尝试，默认 3）
MAX_ACCOUNT_ATTEMPTS=3

# 单账号并发调用上限（默认 10）
MAX_CONCURRENCY_PER_ACCOUNT=10

# 会话绑定 TTL 毫秒数（默认 3600000 即 1 小时）
SESSION_BINDING_TTL_MS=3600000

# 上游请求超时（毫秒，默认 300000 即 5 分钟）
UPSTREAM_TIMEOUT_MS=300000

# === 历史续接与隐私存储 (ADR-0003 & Issue #08) ===
# 服务端可选内存历史续接（1=开，0=关）
ENABLE_IN_MEMORY_CONTINUATION=1
# 内存中最多保留多少个最近响应上下文（LRU 淘汰，默认 500）
MAX_RESPONSE_HISTORY=500
# 响应上下文有效时长（秒，过期后明确报 404，默认 3600 秒）
RESPONSE_HISTORY_TTL_SECONDS=3600

# 调试抓包（默认 0 = 关闭）
# 设为 1 后，每个请求入参和原始 SSE 写入 DUMP_DIR；系统提供有界自动清理
DEBUG_DUMP=0
DUMP_DIR=/data/gw-logs
# 上限三项的变量名与单位必须和 src/api-bridge.js 读取的一致：
# 文件数 / 总字节数（不是 MB）/ 过期秒数（不是小时）
DEBUG_DUMP_MAX_FILES=50
DEBUG_DUMP_MAX_BYTES=52428800
DEBUG_DUMP_MAX_AGE_SEC=86400

# === 多模态与请求体限制 ===
# 单次请求最多几张图（默认 8）
MAX_IMAGES=8

# 请求体上限 MB。base64 图片会撑大请求体，超过就返回 413
MAX_BODY_MB=12

# 1（默认）= 尊重请求里的 model 字段，按模型路由或显式别名
MODEL_OVERRIDE=1

# 透传给 CLI 的思考等级（仅 agent 模式）：off / minimal / low / medium / high / adaptive
THINKING_LEVEL=

# === 思考模式 ===
# off  = 关闭思考（默认）。上游思考模式会往回带 reasoning_content，关掉后兼容性最好
# auto = 不干预，用上游默认（会思考）
# low / medium / high = 指定思考强度
REASONING=off

# === 数据持久化路径 ===
GATEWAY_DATA_DIR=/data
STATE_PATH=/data/usage-state.json
